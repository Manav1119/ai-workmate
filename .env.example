# Copy to .env (used by docker compose). Never commit the real .env.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
READONLY_DB_PASSWORD=change-me-reader
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# LLM (optional). Leave LLM_PROVIDER=none for demo mode.
LLM_PROVIDER=none          # none | anthropic | openai
LLM_API_KEY=
LLM_MODEL=                 # e.g. claude-sonnet-4-5 or gpt-4.1-mini
LLM_BASE_URL=              # optional, for OpenAI-compatible gateways

ALLOW_DEMO_LOGIN=true
COOKIE_SECURE=false        # set true behind HTTPS
SEED_ON_START=true
