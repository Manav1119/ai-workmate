      "start": "2026-09-28",
      "end": "2026-10-18",
      "expected_detection_metrics": [
        "spend",
        "clicks",
        "roas",
        "conversion_rate",
        "cpa"
      ],
      "expect_anomaly": true
    },
    {
      "id": "S3_missing_data",
      "campaign_id": "C007",
      "type": "data_quality",
      "description": "No rows delivered for 'Display - Remarketing' 2026-09-14..2026-09-20 (simulated pipeline outage). The campaign was running.",
      "start": "2026-09-14",
      "end": "2026-09-20",
      "expected_detection_metrics": [
        "missing_data"
      ],
      "expect_anomaly": true
