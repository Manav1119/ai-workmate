FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app ./app
COPY migrations ./migrations
COPY scripts ./scripts
COPY seed ./seed
COPY eval ./eval
COPY docker-entrypoint.sh ./
RUN useradd --create-home --uid 10001 workmate && mkdir -p /tmp/ai-workmate-uploads \
    && chown -R workmate /app /tmp/ai-workmate-uploads && chmod +x docker-entrypoint.sh
USER workmate
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
